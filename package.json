{
  "name": "@arcadia-finance/mcp-server",
  "mcpName": "io.github.arcadia-finance/mcp-server",
  "version": "0.7.2",
  "description": "MCP server for Arcadia Finance. Deploy concentrated liquidity on Uniswap/Aero, Aerodrome and Velodrome with automated rebalancing, compounding, yield optimization, and leverage, or single-sided liquidity into lending pools. Live on Base, Optimism, Unichain and Robinhood.",
  "type": "module",
  "license": "AGPL-3.0",
  "packageManager": "yarn@4.13.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcadia-finance/mcp-server.git"
  },
  "homepage": "https://arcadia.finance",
  "keywords": [
    "mcp",
    "mcp-server",
    "ai-agent",
    "arcadia",
    "defi",
    "lending",
    "concentrated-liquidity",
    "clamm",
    "liquidity",
    "uniswap",
    "aero",
    "aerodrome",
    "slipstream",
    "base",
    "unichain",
    "optimism",
    "robinhood",
    "ethereum",
    "leverage",
    "yield-farming",
    "rebalancing",
    "compounding",
    "lp-management",
    "automation",
    "onchain"
  ],
  "files": [
    "dist",
    "skills",
    "server.json",
    "llms.txt",
    "llms-full.txt",
    "README.md",
    "LICENSE.md"
  ],
  "bin": {
    "arcadia-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && cp src/abis/*.json dist/abis/",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "sync-version": "node tools/sync-version.mjs",
    "prepublishOnly": "yarn sync-version && yarn build"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "posthog-node": "5.63.2",
    "viem": "^2.57.17",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
